                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div>
                            <h3 class="font-bold text-slate-900 text-sm">Peta Konsep & Struktur Logis AI Ethics</h3>
                            <p class="text-xs text-slate-500">Grafik keterhubungan otomatis hasil sintesis materi esai.</p>
                        </div>
                        <span class="text-xs font-mono text-slate-400">Interactive SVG Node</span>
                    </div>

                    <div class="w-full bg-slate-900 rounded-lg p-4 min-h-[360px] flex items-center justify-center relative overflow-hidden">
                        <!-- SVG Mind Map Simulation -->
                        <svg class="w-full h-80" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg">
                            <!-- Connection Lines -->
                            <line x1="300" y1="150" x2="150" y2="80" stroke="#0284c7" stroke-width="2" stroke-dasharray="4" />
                            <line x1="300" y1="150" x2="450" y2="80" stroke="#0284c7" stroke-width="2" stroke-dasharray="4" />
                            <line x1="300" y1="150" x2="180" y2="230" stroke="#0284c7" stroke-width="2" stroke-dasharray="4" />
                            <line x1="300" y1="150" x2="420" y2="230" stroke="#0284c7" stroke-width="2" stroke-dasharray="4" />

                            <!-- Central Node -->
                            <g class="cursor-pointer">
                                <circle cx="300" cy="150" r="38" fill="#0369a1" stroke="#38bdf8" stroke-width="3" />
                                <text x="300" y="146" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="bold">AI Adaptif</text>
                                <text x="300" y="159" text-anchor="middle" fill="#bae0fd" font-size="9">& Integritas</text>
                            </g>

                            <!-- Node 1: VARK Engine -->
                            <g class="cursor-pointer hover:opacity-90 transition-opacity">
                                <circle cx="150" cy="80" r="28" fill="#0f172a" stroke="#0284c7" stroke-width="2" />
                                <text x="150" y="78" text-anchor="middle" fill="#ffffff" font-size="10" font-weight="semibold">Engine VARK</text>
                                <text x="150" y="90" text-anchor="middle" fill="#94a3b8" font-size="8">Personalisasi</text>
                            </g>

