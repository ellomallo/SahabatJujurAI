        // 1. Navigation Controller
        function switchTab(tabId) {
            // Hide all contents
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            
            // Show target
            const target = document.getElementById('tab-' + tabId);
            if (target) target.classList.remove('hidden');

            // Update sidebar buttons
            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('bg-slate-100', 'text-slate-900', 'font-semibold');
                el.classList.add('text-slate-600');
            });

            const activeNav = document.getElementById('nav-' + tabId);
            if (activeNav) {
                activeNav.classList.add('bg-slate-100', 'text-slate-900', 'font-semibold');
                activeNav.classList.remove('text-slate-600');
            }

            // Sync mobile select dropdown
            const mobileNav = document.getElementById('mobile-nav');
            if (mobileNav) mobileNav.value = tabId;

            // Re-render chart if switching to integrity tab
            if (tabId === 'integrity') {
                renderIntegrityChart();
            }
        }

        // Initialize default tab
        switchTab('diagnostic');

        // 2. Diagnostic Tool Logic (VARK Test)
        function updateDiagnostic() {
            const form = document.getElementById('vark-form');
            const q1 = form.elements['q1'].value;
            const q2 = form.elements['q2'].value;
            const q3 = form.elements['q3'].value;
            const q4 = form.elements['q4'].value;

            let answers = [q1, q2, q3, q4].filter(Boolean);
            document.getElementById('diagnostic-progress').innerText = `Terisi ${answers.length} dari 4`;

            if (answers.length === 0) return;

            let countV = answers.filter(x => x === 'V').length;
            let countA = answers.filter(x => x === 'A').length;
            let countK = answers.filter(x => x === 'K').length;
            let total = answers.length;

            let pctV = Math.round((countV / total) * 100);
            let pctA = Math.round((countA / total) * 100);
            let pctK = Math.round((countK / total) * 100);

            // Update DOM UI
            document.getElementById('vark-v-val').innerText = pctV + '%';
            document.getElementById('vark-v-bar').style.width = pctV + '%';

            document.getElementById('vark-a-val').innerText = pctA + '%';
            document.getElementById('vark-a-bar').style.width = pctA + '%';

            document.getElementById('vark-k-val').innerText = pctK + '%';
            document.getElementById('vark-k-bar').style.width = pctK + '%';

            // Title & Description Logic
            const titleEl = document.getElementById('vark-result-title');
            const descEl = document.getElementById('vark-result-desc');

            if (pctV >= pctA && pctV >= pctK) {
                titleEl.innerText = `Visual Dominant (${pctV}%)`;
                descEl.innerText = "Anda sangat responsif terhadap pemetaan visual, hierarki diagram, dan bagan alir. Sistem memprioritaskan Mind Map interaktif pada Multi-Modal Hub.";
            } else if (pctA >= pctV && pctA >= pctK) {
                titleEl.innerText = `Auditori Dominant (${pctA}%)`;
                descEl.innerText = "Anda paling mudah mencerna materi lewat dialog pendengaran. Sistem memprioritaskan Rangkuman Audio Podcast pada Multi-Modal Hub.";
            } else {
                titleEl.innerText = `Kinestetik Dominant (${pctK}%)`;
                descEl.innerText = "Anda belajar paling efektif dengan praktek dan uji aktif. Sistem memprioritaskan Flashcard Interaktif pada Multi-Modal Hub.";
            }
        }

        function applyDiagnosticAndRedirect() {
            switchTab('notebook');
        }

        // 3. Multi-Modal Hub Tab Selector
        function setModalTab(type) {
            document.getElementById('sub-visual').classList.add('hidden');
            document.getElementById('sub-auditory').classList.add('hidden');
            document.getElementById('sub-kinesthetic').classList.add('hidden');

            document.getElementById('modal-tab-visual').className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-all';
            document.getElementById('modal-tab-auditory').className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-all';
            document.getElementById('modal-tab-kinesthetic').className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-all';

            document.getElementById('sub-' + type).classList.remove('hidden');
            document.getElementById('modal-tab-' + type).className = 'px-3 py-1.5 rounded-md bg-white text-slate-900 shadow-sm transition-all font-semibold';
        }

        // Flip Card Logic
        function flipCard() {
            document.getElementById('flashcard').classList.toggle('flashcard-flipped');
        }

        // Audio Simulation Logic
        let isAudioPlaying = false;
        function toggleAudioSimulation() {
            isAudioPlaying = !isAudioPlaying;
            const btnIcon = document.getElementById('play-icon');
            if (isAudioPlaying) {
                btnIcon.setAttribute('data-lucide', 'pause');
            } else {
                btnIcon.setAttribute('data-lucide', 'play');
            }
            lucide.createIcons();
        }

        // 4. Adaptive 30-15-15 Interval Timer Logic
        let timerSeconds = 30 * 60;
        let currentPhase = 1; // 1: 30m, 2: 15m, 3: 15m
        let isTimerRunning = false;
        let timerInterval = null;

        const phaseConfig = {
            1: { duration: 30 * 60, title: "Fase 1: Pendalaman Konsep (30 Min)", desc: "Fokus membaca dan memahami materi tanpa gangguan distrasi eksternal." },
            2: { duration: 15 * 60, title: "Fase 2: Latihan Adaptif (15 Min)", desc: "Pengerjaan latihan soal aktif untuk menguji pemahaman konsep." },
            3: { duration: 15 * 60, title: "Fase 3: Evaluasi & Review AI (15 Min)", desc: "Melihat umpan balik koreksi AI dan istirahat pemulihan kognitif." }
        };

        function updateTimerDisplay() {
            const mins = Math.floor(timerSeconds / 60);
            const secs = timerSeconds % 60;
            document.getElementById('timer-display').innerText = 
                `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

            const totalDuration = phaseConfig[currentPhase].duration;
            const pct = ((totalDuration - timerSeconds) / totalDuration) * 100;
            document.getElementById('timer-progress').style.width = pct + '%';
        }

        function toggleTimer() {
            if (isTimerRunning) {
                clearInterval(timerInterval);
                isTimerRunning = false;
                document.getElementById('timer-btn-text').innerText = "Lanjutkan Sesi";
            } else {
                isTimerRunning = true;
                document.getElementById('timer-btn-text').innerText = "Jeda Sesi";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        updateTimerDisplay();
                    } else {
                        skipPhase();
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            timerSeconds = phaseConfig[currentPhase].duration;
            document.getElementById('timer-btn-text').innerText = "Mulai Sesi";
            updateTimerDisplay();
        }

        function skipPhase() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            currentPhase = currentPhase === 3 ? 1 : currentPhase + 1;
            
            // Update Phase Card UI
            document.getElementById('timer-phase-title').innerText = phaseConfig[currentPhase].title;
            document.getElementById('timer-phase-desc').innerText = phaseConfig[currentPhase].desc;
            
            timerSeconds = phaseConfig[currentPhase].duration;
            document.getElementById('timer-btn-text').innerText = "Mulai Sesi";
            updateTimerDisplay();

            // Highlight Cards
            [1, 2, 3].forEach(p => {
                const card = document.getElementById('phase-card-' + p);
                if (p === currentPhase) {
                    card.className = "p-3 rounded-lg bg-slate-800 border-l-4 border-brand-500 space-y-1";
                } else {
                    card.className = "p-3 rounded-lg bg-slate-800/40 border-l-4 border-slate-700 space-y-1 opacity-70";
                }
            });
        }

        // 5. Academic Integrity Pledge Check
        function checkPledge() {
            const p1 = document.getElementById('pledge-1').checked;
            const p2 = document.getElementById('pledge-2').checked;
            const p3 = document.getElementById('pledge-3').checked;
            const btn = document.getElementById('pledge-btn');

            if (p1 && p2 && p3) {
                btn.disabled = false;
                btn.className = "w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-lg transition-all shadow-sm cursor-pointer";
                btn.innerText = "Tanda Tangan Komitmen Digital (Aktif)";
            } else {
                btn.disabled = true;
                btn.className = "w-full py-2.5 bg-slate-800 text-slate-500 font-semibold text-xs rounded-lg transition-all cursor-not-allowed";
                btn.innerText = "Tanda Tangan Komitmen Digital";
            }
        }

        // 6. Chart.js Analytics Render
        let integrityChartInstance = null;
        function renderIntegrityChart() {
            if (integrityChartInstance) integrityChartInstance.destroy();

            const ctx = document.getElementById('integrityChart').getContext('2d');
            integrityChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'],
                    datasets: [
                        {
                            label: 'Konsistensi Interval (EduMind)',
                            data: [85, 88, 92, 90, 95, 94, 96],
                            borderColor: '#0284c7',
                            backgroundColor: 'rgba(2, 132, 199, 0.08)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 4,
                            pointBackgroundColor: '#0284c7'
                        },
                        {
                            label: 'Tingkat Kecemasan Tugas',
                            data: [70, 65, 50, 45, 35, 30, 25],
                            borderColor: '#ef4444',
                            borderDash: [5, 5],
                            tension: 0.3,
                            borderWidth: 1.5,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: { family: 'Inter', size: 11 },
                                boxWidth: 12
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { family: 'Inter', size: 10 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Inter', size: 10 } }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>
