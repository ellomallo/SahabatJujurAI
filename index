                                </label>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                    <label class="border border-slate-200 hover:border-slate-300 rounded-lg p-3 flex flex-col cursor-pointer bg-slate-50/50 hover:bg-slate-50 transition-all text-xs">
                                        <input type="radio" name="q3" value="V" class="mb-2 text-brand-600 focus:ring-brand-600" onchange="updateDiagnostic()">
