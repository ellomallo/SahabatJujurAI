                                    </label>
                                    <label class="border border-slate-200 hover:border-slate-300 rounded-lg p-3 flex flex-col cursor-pointer bg-slate-50/50 hover:bg-slate-50 transition-all text-xs">
                                        <input type="radio" name="q4" value="K" class="mb-2 text-brand-600 focus:ring-brand-600" onchange="updateDiagnostic()">
                                        <span class="font-semibold text-slate-900">Berikan Studi Kasus</span>
                                        <span class="text-slate-500 mt-1">Kirim simulasi soal ujian bertingkat.</span>
                                    </label>
                                </div>
                            </div>
                        </form>
