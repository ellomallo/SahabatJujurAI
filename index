    <!-- NAVIGATION TABS -->
    <nav class="bg-white border-b border-slate-200 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto space-x-6 py-2">
            <button onclick="switchTab('beranda')" id="btn-beranda" class="tab-btn flex items-center space-x-2 pb-2 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 whitespace-nowrap">
                <i data-lucide="home" class="w-4 h-4"></i><span>Beranda Utama</span>
            </button>
            <button onclick="switchTab('diagnostik')" id="btn-diagnostik" class="tab-btn flex items-center space-x-2 pb-2 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
                <i data-lucide="brain" class="w-4 h-4"></i><span>Diagnosis Gaya Belajar</span>
            </button>
            <button onclick="switchTab('notebook')" id="btn-notebook" class="tab-btn flex items-center space-x-2 pb-2 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
                <i data-lucide="book-open" class="w-4 h-4"></i><span>Notebook AI (Multi-Modal)</span>
            </button>
            <button onclick="switchTab('timer')" id="btn-timer" class="tab-btn flex items-center space-x-2 pb-2 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
                <i data-lucide="timer" class="w-4 h-4"></i><span>Blok Belajar 30-15-15</span>
            </button>
            <button onclick="switchTab('integritas')" id="btn-integritas" class="tab-btn flex items-center space-x-2 pb-2 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
                <i data-lucide="shield-check" class="w-4 h-4"></i><span>Pusat Integritas & Analitik</span>
            </button>
        </div>
    </nav>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- TAB 1: BERANDA -->
        <section id="tab-beranda" class="tab-content space-y-6">
            <div class="bg-gradient-to-r from-slate-900 to-slate-800 rounded-2xl p-8 text-white shadow-xl relative overflow-hidden">
                <div class="absolute right-0 top-0 translate-x-1/4 -translate-y-1/4 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="max-w-2xl relative z-10">
                    <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-semibold mb-4 border border-emerald-500/30">Solusi Keadilan Pendidikan & Pencegahan Korupsi</span>
                    <h2 class="text-3xl font-bold tracking-tight mb-4">Wujudkan Integritas Akademik Tanpa Celah Menuju Indonesia Emas 2045</h2>
                    <p class="text-slate-300 text-sm leading-relaxed mb-6">
                        Mencontek di ruang kelas adalah akar mentalitas jalan pintas menuju tindakan korupsi pejabat di masa depan. EduMind-AI hadir meratakan akses pemahaman materi lewat personalisasi belajar cerdas, memangkas kepanikan ujian, dan membangun kejujuran sejak dini.
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="switchTab('diagnostik')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-5 py-2.5 rounded-xl text-sm transition shadow-sm flex items-center space-x-2">
                            <span>Mulai Tes Gaya Belajar</span><i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </button>
                        <button onclick="switchTab('notebook')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold px-5 py-2.5 rounded-xl text-sm transition">
                            Jelajahi Notebook AI
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-4">01</div>
                        <h3 class="font-bold text-slate-900 mb-2">Pemberantasan Akar Korupsi</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">Menghilangkan budaya mencontek akibat kepanikan belajar dengan membina kejujuran berbasis gamifikasi penghargaan integritas.</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-semibold text-emerald-600 flex items-center justify-between">
                        <span>Pencegahan Preventif</span><i data-lucide="shield" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-4">02</div>
                        <h3 class="font-bold text-slate-900 mb-2">Personalisasi AI (VARK)</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">Menyesuaikan materi pelajaran otomatis menjadi format Visual, Auditori, atau Kinestetik agar mudah dipahami semua siswa secara adil.</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-semibold text-emerald-600 flex items-center justify-between">
                        <span>Educational Equity</span><i data-lucide="cpu" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
