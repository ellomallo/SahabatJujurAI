                        brand: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 700: '#15803d', 900: '#14532d' }
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full font-sans text-slate-800 antialiased flex flex-col justify-between">

    <!-- TOP HEADER BAR -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white shadow-sm font-bold text-lg">
                    AI
                </div>
                <div>
                    <h1 class="font-bold text-slate-900 leading-tight">EduMind-AI</h1>
                    <p class="text-xs text-slate-500 font-medium">Inovasi Gempita Nusantara #3 • Indonesia Emas 2045</p>
                </div>
            </div>
            <div class="hidden md:flex items-center space-x-2 text-xs font-semibold px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200">
