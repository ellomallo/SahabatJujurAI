                                        <span class="text-slate-500 mt-1">Sulit paham jika tidak ada contoh penerapan praktis.</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Q4 -->
                            <div class="space-y-3">
                                <label class="text-sm font-semibold text-slate-800 block">
